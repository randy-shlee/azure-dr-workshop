using './main.bicep'

param prefix = readEnvironmentVariable('PREFIX', 'kkbdrtest')
param owner = readEnvironmentVariable('OWNER_EMAIL', 'owner@example.com')
param expiry = readEnvironmentVariable('EXPIRY', '2026-11-27')
param monthlyBudget = int(readEnvironmentVariable('MONTHLY_BUDGET', '1000'))
param allowedClientCidrs = split(readEnvironmentVariable('ALLOWED_CLIENT_CIDRS', '203.0.113.10/32'), ',')
param administratorLogin = readEnvironmentVariable('PG_ADMIN_LOGIN', 'dradmin')
param administratorPassword = readEnvironmentVariable('PG_ADMIN_PASSWORD')
param deployEventHubs = bool(readEnvironmentVariable('DEPLOY_EVENT_HUBS', 'true'))
param deployRedis = bool(readEnvironmentVariable('DEPLOY_REDIS', 'true'))
param deployAiSearch = bool(readEnvironmentVariable('DEPLOY_AI_SEARCH', 'true'))
param enableAcrGeoReplication = bool(readEnvironmentVariable('ENABLE_ACR_GEO_REPLICATION', 'false'))
param enableEventHubsGeoReplication = bool(readEnvironmentVariable('ENABLE_EH_GEO_REPLICATION', 'true'))
param maxReplicationLagSeconds = int(readEnvironmentVariable('MAX_REPLICATION_LAG_SECONDS', '300'))
param deployAppGateway = bool(readEnvironmentVariable('DEPLOY_APP_GATEWAY', 'false'))
param deployDnsResolver = bool(readEnvironmentVariable('DEPLOY_DNS_RESOLVER', 'false'))
param deployAlerts = bool(readEnvironmentVariable('DEPLOY_ALERTS', 'false'))
param enableStorageLastSyncCustomMetricAlert = bool(readEnvironmentVariable('ENABLE_STORAGE_LAST_SYNC_CUSTOM_METRIC_ALERT', 'false'))
param fastFailover = bool(readEnvironmentVariable('FAST_FAILOVER', 'false'))
param aksVmSize = readEnvironmentVariable('AKS_VM_SIZE', 'Standard_D4s_v5')
param aksNodeCount = int(readEnvironmentVariable('AKS_NODE_COUNT', '2'))
param useEphemeralOsDisk = bool(readEnvironmentVariable('USE_EPHEMERAL_OS_DISK', 'false'))
param kubernetesVersion = readEnvironmentVariable('KUBERNETES_VERSION', '')
param postgresVmSize = readEnvironmentVariable('PG_VM_SIZE', 'Standard_D2ds_v5')
param sampleDataSizeGB = int(readEnvironmentVariable('SAMPLE_DATA_SIZE_GB', '100'))
param largeFileSizeGB = int(readEnvironmentVariable('LARGE_FILE_SIZE_GB', '1'))
param smallFileCount = int(readEnvironmentVariable('SMALL_FILE_COUNT', '20000'))
param smallFileSizeMB = int(readEnvironmentVariable('SMALL_FILE_SIZE_MB', '1'))
param skipSampleData = bool(readEnvironmentVariable('SKIP_SAMPLE_DATA', 'false'))
