# Copy to .state/workshop.env and edit before sourcing. No passwords or keys.
export SUBSCRIPTION_ID='replace-with-your-subscription-id'
export PREFIX='drws01'
export OWNER_EMAIL='replace-with-your-real-email'
export EXPIRY='2026-11-27'
export MONTHLY_BUDGET=1000
export ALLOWED_CLIENT_CIDRS='replace-with-your-approved-public-ip/32'
export PG_ADMIN_LOGIN='dradmin'

# Full functional workshop, with a smaller sample dataset.
export DEPLOY_EVENT_HUBS=true
export ENABLE_EH_GEO_REPLICATION=true
export DEPLOY_REDIS=true
export DEPLOY_AI_SEARCH=true
export SAMPLE_DATA_SIZE_GB=10
export LARGE_FILE_SIZE_GB=1
export SMALL_FILE_COUNT=2000
export SMALL_FILE_SIZE_MB=1
export SKIP_SAMPLE_DATA=false

# Keep unrelated/additional-cost options off.
export ENABLE_ACR_GEO_REPLICATION=false
export DEPLOY_APP_GATEWAY=false
export DEPLOY_DNS_RESOLVER=false
export DEPLOY_ALERTS=false
export ENABLE_STORAGE_LAST_SYNC_CUSTOM_METRIC_ALERT=false
export FAST_FAILOVER=false
export AKS_VM_SIZE='Standard_D4s_v5'
export AKS_NODE_COUNT=2
export USE_EPHEMERAL_OS_DISK=false
export PG_VM_SIZE='Standard_D2ds_v5'

# Run from repository root; isolate the team's deployment outputs and logs.
export STATE_DIR="$PWD/.state/$PREFIX"
export CONFIG_FILE="$STATE_DIR/config.json"
# Set to the ACTUAL subscription deployment name shown in Azure Portal.
export DEPLOYMENT_NAME='replace-with-actual-portal-deployment-name'
