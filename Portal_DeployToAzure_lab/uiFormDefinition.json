{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Azure DR Workshop",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "subscription",
              "type": "Microsoft.Common.SubscriptionSelector"
            },
            {
              "name": "locations",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat('/subscriptions/', steps('basics').subscription.subscriptionId, '/locations?api-version=2022-12-01')]"
              }
            },
            {
              "name": "location",
              "type": "Microsoft.Common.DropDown",
              "label": "\ubc30\ud3ec \uc704\uce58",
              "toolTip": "Stores deployment records only; actual resources remain in Korea Central / Korea South.",
              "defaultValue": {"value": "koreacentral"},
              "filter": true,
              "constraints": {
                "required": true,
                "allowedValues": "[map(coalesce(steps('basics').locations.value, parse('[]')), (region) => parse(concat('{\"label\":\"', region.displayName, '\",\"value\":\"', region.name, '\"}')))]"
              }
            },
            {
              "name": "prefix",
              "type": "Microsoft.Common.TextBox",
              "label": "New workshop prefix",
              "constraints": {
                "required": true,
                "regex": "^[a-z][a-z0-9]{2,11}$",
                "validationMessage": "Use 3-12 lowercase letters/digits, starting with a letter. Use a new prefix."
              }
            },
            {
              "name": "expiry",
              "type": "Microsoft.Common.TextBox",
              "label": "Expiry date (YYYY-MM-DD; does not delete resources)",
              "constraints": {
                "required": true,
                "regex": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                "validationMessage": "Enter the approved end date as YYYY-MM-DD."
              }
            },
            {
              "name": "allowedClientCidrs",
              "type": "Microsoft.Common.TextBox",
              "label": "Approved public IPv4 CIDRs (comma separated)",
              "toolTip": "For example: 203.0.113.10/32,198.51.100.20/32. Replace documentation addresses with approved egress addresses.",
              "constraints": {
                "required": true,
                "regex": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[1-9]|[12][0-9]|3[0-2])(?:,(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[1-9]|[12][0-9]|3[0-2]))*$",
                "validationMessage": "Enter IPv4 CIDRs separated by commas without spaces or brackets. /0 is not allowed."
              }
            }
          ]
        },
        {
          "name": "postgres",
          "label": "PostgreSQL",
          "elements": [
            {
              "name": "administratorLogin",
              "type": "Microsoft.Common.TextBox",
              "label": "PostgreSQL admin ID",
              "defaultValue": "[concat('pgadmin', substring(replace(utcNow(), '-', ''), 4, 4))]",
              "toolTip": "1-63 letters/digits. No reserved names or pg_ prefix. Default: pgadmin + today's UTC MMdd (for example pgadmin1030).",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[a-zA-Z0-9]{1,63}$",
                    "message": "Use 1-63 letters/digits only; pg_ prefixes are not allowed."
                  },
                  {
                    "isValid": "[not(contains(parse('[\"admin\",\"administrator\",\"azure_superuser\",\"azure_pg_admin\",\"azuresu\",\"guest\",\"public\",\"root\",\"postgres\"]'), toLower(steps('postgres').administratorLogin)))]",
                    "message": "This admin ID is reserved. Choose another ID, such as the date-based default."
                  },
                  {
                    "isValid": "[not(contains(toLower(coalesce(steps('postgres').administratorPassword, '')), toLower(coalesce(steps('postgres').administratorLogin, ''))))]",
                    "message": "The password must not contain the admin ID (case-insensitive)."
                  }
                ]
              }
            },
            {
              "name": "passwordRules",
              "type": "Microsoft.Common.TextBlock",
              "options": {
                "text": "Password: 12-128 characters; at least 3 of uppercase, lowercase, digits, symbols. Must not contain the admin ID. Workshop minimum: 12 (PostgreSQL minimum: 8)."
              }
            },
            {
              "name": "administratorPassword",
              "type": "Microsoft.Common.PasswordBox",
              "label": {"password": "PostgreSQL admin password", "confirmPassword": "Confirm password"},
              "toolTip": "12-128 characters; at least 3 of uppercase, lowercase, digits, symbols; must not contain the admin ID.",
              "constraints": {
                "required": true,
                "regex": "^(?:(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])|(?=.*[A-Z])(?=.*[a-z])(?=.*[^a-zA-Z0-9])|(?=.*[A-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9])|(?=.*[a-z])(?=.*[0-9])(?=.*[^a-zA-Z0-9])).{12,128}$",
                "validationMessage": "Use 12-128 characters and at least 3 of uppercase, lowercase, digits, symbols."
              },
              "options": {"hideConfirmation": false}
            }
          ]
        },
        {
          "name": "capacity",
          "label": "Capacity",
          "elements": [
            {
              "name": "aksVmSize",
              "type": "Microsoft.Common.TextBox",
              "label": "Approved AKS VM size",
              "defaultValue": "Standard_D4s_v5",
              "constraints": {"required": true}
            },
            {
              "name": "aksNodeCount",
              "type": "Microsoft.Common.TextBox",
              "label": "AKS nodes per region",
              "defaultValue": "2",
              "constraints": {"required": true, "regex": "^(?:[2-9]|[1-9][0-9]+)$", "validationMessage": "Enter an integer of at least 2."}
            },
            {
              "name": "kubernetesVersion",
              "type": "Microsoft.Common.TextBox",
              "label": "Kubernetes version (optional)",
              "defaultValue": ""
            },
            {
              "name": "useEphemeralOsDisk",
              "type": "Microsoft.Common.CheckBox",
              "label": "Use ephemeral AKS OS disks"
            },
            {
              "name": "postgresVmSize",
              "type": "Microsoft.Common.DropDown",
              "label": "Approved PostgreSQL VM size",
              "defaultValue": "Standard_D2ds_v5",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {"label": "Standard_D2ds_v5", "value": "Standard_D2ds_v5"},
                  {"label": "Standard_D2ds_v4", "value": "Standard_D2ds_v4"}
                ]
              }
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "Subscription",
      "subscriptionId": "[steps('basics').subscription.subscriptionId]",
      "location": "[steps('basics').location]",
      "parameters": {
        "prefix": "[steps('basics').prefix]",
        "expiry": "[steps('basics').expiry]",
        "allowedClientCidrs": "[split(steps('basics').allowedClientCidrs, ',')]",
        "administratorLogin": "[steps('postgres').administratorLogin]",
        "administratorPassword": "[steps('postgres').administratorPassword]",
        "aksVmSize": "[steps('capacity').aksVmSize]",
        "aksNodeCount": "[int(steps('capacity').aksNodeCount)]",
        "kubernetesVersion": "[steps('capacity').kubernetesVersion]",
        "useEphemeralOsDisk": "[steps('capacity').useEphemeralOsDisk]",
        "postgresVmSize": "[steps('capacity').postgresVmSize]"
      }
    }
  }
}